# Пароль для входа в /admin
ADMIN_PASSWORD=admin

# Секрет для подписи admin-cookie. В продакшене обязательно поменяй.
ADMIN_SECRET=change-me-in-prod

# Telegram (используется notification-сервисом для пересылки сообщений из формы обратной связи)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CORS для Flask-сервисов (по умолчанию разрешён фронтенд на :3000)
CORS_ORIGINS=http://localhost:3000

# Если нужен дебаг-режим Flask
FLASK_DEBUG=0
