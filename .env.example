# ============================================
# Django (web_service)
# ============================================

# ВАЖНО: сгенерируйте уникальный ключ для прода.
# Python: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string

# В проде ВСЕГДА 0. На Railway оставляйте 0.
DJANGO_DEBUG=0

# Список разрешённых хостов (через запятую).
# Railway сам подставит свой домен через RAILWAY_PUBLIC_DOMAIN.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# База данных. Railway даёт DATABASE_URL автоматически после привязки PostgreSQL.
# DATABASE_URL=postgres://user:pass@host:5432/dbname

# ============================================
# Микросервисы (URL внутри Railway)
# ============================================

# URL для связи Django с микросервисами.
# Локально (Docker Compose): http://comments:8001 и http://notification:8002
# На Railway: https://<service-name>.up.railway.app
COMMENTS_SERVICE_URL=http://comments:8001
NOTIFICATION_SERVICE_URL=http://notification:8002

# ============================================
# Telegram (notification_service)
# ============================================

# Получите токен у @BotFather
TELEGRAM_BOT_TOKEN=

# ID чата, куда отправлять уведомления.
# Узнать: напишите боту, потом откройте https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_CHAT_ID=

# ============================================
# CORS (для микросервисов)
# ============================================

CORS_ORIGINS=http://localhost:8000

# Включить дев-режим Flask (только для локалки!)
FLASK_DEBUG=0
